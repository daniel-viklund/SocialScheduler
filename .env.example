# Copy to .env and fill in. See README.md for step-by-step setup.

# Server
PORT=3000
# Where the app itself is reachable (used for the Google OAuth redirect)
APP_URL=http://localhost:3000

# --- YouTube (Google Cloud OAuth client, YouTube Data API v3) ---
YT_CLIENT_ID=
YT_CLIENT_SECRET=
# public | unlisted | private
YT_PRIVACY=public

# --- Instagram (Instagram API with Instagram Login) ---
# From the Meta app dashboard: Instagram > API setup with Instagram login.
# These are the *Instagram* app ID/secret, not the Facebook app ID/secret.
IG_APP_ID=
IG_APP_SECRET=
# Must be a public https URL (cloudflared/ngrok tunnel, or your server's domain).
# Used for BOTH the Instagram OAuth redirect and the media URL Instagram fetches.
PUBLIC_BASE_URL=
